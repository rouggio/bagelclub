NODE_ENV=development
PORT=3000
# Runtime pool: least-privilege app role (RLS-enforced). Owners bypass RLS.
DATABASE_URL=postgres://app_user:app_user_dev@localhost:5432/empanadel
# Trust-root pool (auth credential checks, webhook token bootstrap, seeds):
# table owner. Falls back to DATABASE_URL for single-role setups.
AUTH_DATABASE_URL=postgres://postgres:postgres@localhost:5432/empanadel
OWNER_DATABASE_URL=postgres://postgres:postgres@localhost:5432/empanadel
JWT_SECRET=change-me-32-chars-min
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# Superadmin 2FA (Telegram OTP): bot token + your chat id as secrets.
# Production (Render): set both, no fallback. Local dev without them logs the
# code to the server console instead of sending (never in production).
SUPERADMIN_TELEGRAM_BOT_TOKEN=
SUPERADMIN_TELEGRAM_CHAT_ID=
CORS_ORIGIN=http://localhost:5173
CLUB_TIMEZONE=Europe/Rome
